@using FlowMind.Data
@using Microsoft.EntityFrameworkCore
@inject FlowMindDbContext _context

@{
    var notifications = _context.Notifications
        .OrderByDescending(n => n.OlusturmaTarihi)
        .Take(5)
        .ToList();
        
    var unreadCount = _context.Notifications.Count(n => !n.Okundu);

    var currentUserName = Context.Request.Cookies["CurrentUserName"];
    var currentUserRole = Context.Request.Cookies["CurrentUserRole"];
    bool hasRole = !string.IsNullOrEmpty(currentUserName);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FlowMind - AI destekli iş akışı orkestrasyon platformu" />
    <title>@ViewData["Title"] - FlowMind</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="fm-sidebar" id="sidebar">
        <div class="fm-sidebar-header">
            <a href="/" class="fm-logo">
                <span class="fm-logo-icon">⚡</span>
                <span class="fm-logo-text">FlowMind</span>
            </a>
        </div>

        <nav class="fm-sidebar-nav">
            <span class="fm-nav-section-title">Ana Menü</span>

            <a href="/Home/Index" class="fm-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" id="nav-dashboard">
                <span class="fm-sidebar-icon">📊</span>
                <span class="fm-sidebar-label">Dashboard</span>
            </a>

            <a href="/Workflow/Index" class="fm-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workflow" ? "active" : "")" id="nav-workflows">
                <span class="fm-sidebar-icon">🔄</span>
                <span class="fm-sidebar-label">İş Akışları</span>
            </a>

            <a href="/Task/Index" class="fm-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Task" ? "active" : "")" id="nav-tasks">
                <span class="fm-sidebar-icon">📋</span>
                <span class="fm-sidebar-label">Görevler</span>
            </a>

            <span class="fm-nav-section-title">Sistem</span>

            <a href="/Integration/Index" class="fm-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Integration" ? "active" : "")" id="nav-integrations">
                <span class="fm-sidebar-icon">🔌</span>
                <span class="fm-sidebar-label">Entegrasyonlar</span>
            </a>

            <a href="/Audit/Index" class="fm-sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Audit" ? "active" : "")" id="nav-audit">
                <span class="fm-sidebar-icon">📋</span>
                <span class="fm-sidebar-label">Denetim Günlüğü</span>
            </a>

            <a href="/Home/Hakkinda" class="fm-sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Hakkinda" ? "active" : "")" id="nav-about">
                <span class="fm-sidebar-icon">ℹ️</span>
                <span class="fm-sidebar-label">Hakkında</span>
            </a>
        </nav>

        <div class="fm-sidebar-footer" style="display: flex; flex-direction: column; gap: 10px;">
            @if(hasRole) {
                <div style="background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px;">
                    <div style="font-size: 0.8rem; color: var(--fm-text-muted);">Aktif Kullanıcı</div>
                    <div style="font-weight: 600; font-size: 0.9rem;">@currentUserName</div>
                    <div style="font-size: 0.75rem; color: var(--fm-primary);">@currentUserRole</div>
                </div>
                <button type="button" onclick="document.getElementById('roleModal').style.display='flex'" style="background: transparent; border: 1px solid var(--fm-border); color: var(--fm-text-primary); padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; width: 100%;">🔄 Rol Değiştir</button>
            }
            <div class="fm-sidebar-status">
                <span class="fm-pulse-dot"></span>
                <span>Sistem Aktif</span>
            </div>
            <span class="fm-sidebar-version">v1.0.0</span>
        </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="fm-main-wrapper">
        <!-- Top Header -->
        <header class="fm-topbar" id="topbar">
            <button class="fm-hamburger" id="sidebarToggle" aria-label="Menüyü aç/kapat">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <h1 class="fm-topbar-title">@ViewData["Title"]</h1>
            <div class="fm-topbar-right">
                
                <!-- Notification Bell -->
                <div class="fm-notification-wrapper" style="position: relative; margin-right: 1.5rem;">
                    <button class="fm-notification-btn" id="notificationBtn" aria-label="Bildirimler" style="background: none; border: none; font-size: 1.25rem; position: relative; cursor: pointer;">
                        🔔
                        @if(unreadCount > 0)
                        {
                            <span class="fm-notification-badge" style="position: absolute; top: -5px; right: -5px; background: var(--fm-danger); color: white; border-radius: 50%; padding: 2px 6px; font-size: 0.7rem; font-weight: bold;">@unreadCount</span>
                        }
                    </button>
                    
                    <div class="fm-notification-dropdown" id="notificationDropdown" style="display: none; position: absolute; right: 0; top: 100%; width: 320px; background: #1e1e2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 1000; overflow: hidden; margin-top: 10px;">
                        <div class="fm-notification-header" style="padding: 1rem; border-bottom: 1px solid var(--fm-border); display: flex; justify-content: space-between; align-items: center;">
                            <h6 style="margin: 0; font-weight: 600;">Bildirimler</h6>
                            <span style="font-size: 0.8rem; color: var(--fm-text-secondary);">Son 5</span>
                        </div>
                        <div class="fm-notification-body" style="max-height: 350px; overflow-y: auto;">
                            @if(notifications.Any())
                            {
                                foreach(var notif in notifications)
                                {
                                    <div class="fm-notification-item @(notif.Okundu ? "" : "unread")" style="padding: 1rem; border-bottom: 1px solid var(--fm-border); transition: background 0.2s; @(notif.Okundu ? "" : "background: rgba(79, 70, 229, 0.05);") cursor: pointer;" onmouseover="this.style.background='var(--fm-hover-bg)'" onmouseout="this.style.background='@(notif.Okundu ? "transparent" : "rgba(79, 70, 229, 0.05)")'">
                                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--fm-text-primary); margin-bottom: 4px;">@notif.Baslik</div>
                                        <div style="font-size: 0.8rem; color: var(--fm-text-secondary); line-height: 1.4;">@notif.Mesaj</div>
                                        <div style="font-size: 0.7rem; color: var(--fm-text-muted); margin-top: 6px; text-align: right;">@notif.OlusturmaTarihi.ToString("HH:mm")</div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="padding: 2rem 1rem; text-align: center; color: var(--fm-text-muted); font-size: 0.85rem;">
                                    Bildiriminiz yok.
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="fm-topbar-badge">
                    <span class="fm-pulse-dot"></span>
                    AI Motor Aktif
                </div>
            </div>
        </header>

        <!-- Content Area -->
        <main class="fm-content" role="main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="fm-footer">
            <span>&copy; 2026 FlowMind - AI Orkestratör</span>
            <span class="fm-footer-version">Hackathon Edition</span>
        </footer>
    </div>

    <!-- Overlay for mobile sidebar -->
    <div class="fm-overlay" id="sidebarOverlay"></div>

    <script>
        // Sidebar toggle
        const sidebar = document.getElementById('sidebar');
        const toggle = document.getElementById('sidebarToggle');
        const overlay = document.getElementById('sidebarOverlay');

        toggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('active');
        });

        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
        });

        // Notification Toggle
        const notifBtn = document.getElementById('notificationBtn');
        const notifDropdown = document.getElementById('notificationDropdown');
        
        if(notifBtn) {
            notifBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                notifDropdown.style.display = notifDropdown.style.display === 'none' ? 'block' : 'none';
            });
            
            document.addEventListener('click', (e) => {
                if (!notifDropdown.contains(e.target) && e.target !== notifBtn) {
                    notifDropdown.style.display = 'none';
                }
            });
        }
    </script>

    <!-- Role Selection Modal -->
    <div id="roleModal" style="display: @(hasRole ? "none" : "flex"); position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(5px);">
        <div style="background: var(--fm-card-bg); padding: 2rem; border-radius: 16px; max-width: 400px; width: 90%; border: 1px solid var(--fm-border); box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
            <h3 style="margin-top: 0; margin-bottom: 0.5rem;">Sisteme Giriş Yapın</h3>
            <p style="color: var(--fm-text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">Demo senaryosu için bir rol seçin. Görevleriniz seçtiğiniz role göre filtrelenecektir.</p>
            
            <form action="/Home/SetRole" method="post" style="display: flex; flex-direction: column; gap: 10px;">
                <button type="submit" name="userId" value="USR-002" class="fm-btn fm-btn-outline" style="justify-content: flex-start; text-align: left;">
                    <span style="font-size: 1.5rem; margin-right: 10px;">👨‍💼</span>
                    <div>
                        <div style="font-weight: bold;">Lütfi Arda</div>
                        <div style="font-size: 0.75rem; opacity: 0.8;">Yönetici (Onay Bekleyenler)</div>
                    </div>
                </button>
                
                <button type="submit" name="userId" value="USR-003" class="fm-btn fm-btn-outline" style="justify-content: flex-start; text-align: left;">
                    <span style="font-size: 1.5rem; margin-right: 10px;">👩‍💼</span>
                    <div>
                        <div style="font-weight: bold;">Esma Mol</div>
                        <div style="font-size: 0.75rem; opacity: 0.8;">Finans (Bütçe ve Ödemeler)</div>
                    </div>
                </button>
                
                <button type="submit" name="userId" value="USR-004" class="fm-btn fm-btn-outline" style="justify-content: flex-start; text-align: left;">
                    <span style="font-size: 1.5rem; margin-right: 10px;">👩‍💻</span>
                    <div>
                        <div style="font-weight: bold;">Sinem Doğan</div>
                        <div style="font-size: 0.75rem; opacity: 0.8;">İnsan Kaynakları / Admin</div>
                    </div>
                </button>

                <button type="submit" name="userId" value="USR-001" class="fm-btn fm-btn-outline" style="justify-content: flex-start; text-align: left;">
                    <span style="font-size: 1.5rem; margin-right: 10px;">👨‍💻</span>
                    <div>
                        <div style="font-weight: bold;">Ahmet Yılmaz</div>
                        <div style="font-size: 0.75rem; opacity: 0.8;">Çalışan (Talep Sahibi)</div>
                    </div>
                </button>
                
                @if(hasRole) {
                    <button type="button" onclick="document.getElementById('roleModal').style.display='none'" class="fm-btn" style="margin-top: 10px; background: transparent; color: var(--fm-text-secondary); border: none;">İptal</button>
                }
            </form>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
