@model FlowMind.Models.PanelViewModel
@{
    ViewData["Title"] = "Ana Panel";
}

<!-- Hoş Geldiniz Bölümü -->
<div class="fm-hero fm-hero-sm">
    <h1 class="fm-hero-title">@Model.HosgeldinMesaji</h1>
    <p class="fm-hero-subtitle">Yapay zeka destekli iş akışı yönetim ve orkestrasyon platformu</p>
</div>

<!-- İstatistik Kartları -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="fm-stat-card fm-stat-total">
            <div class="fm-stat-icon">📊</div>
            <div class="fm-stat-info">
                <span class="fm-stat-number">@Model.ToplamIslemSayisi</span>
                <span class="fm-stat-label">Toplam İşlem Sayısı</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="fm-stat-card fm-stat-active">
            <div class="fm-stat-icon">⏳</div>
            <div class="fm-stat-info">
                <span class="fm-stat-number">@Model.BekleyenOnaySayisi</span>
                <span class="fm-stat-label">Bekleyen Onay</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="fm-stat-card fm-stat-done">
            <div class="fm-stat-icon">🤖</div>
            <div class="fm-stat-info">
                <span class="fm-stat-number">@Model.AIKararSayisi</span>
                <span class="fm-stat-label">AI Kararları (@Model.AIOtomasyonOrani%)</span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="fm-stat-card" style="background: linear-gradient(135deg, var(--fm-primary), var(--fm-accent)); color: white; border-radius: 16px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem; border: none; box-shadow: 0 10px 20px rgba(79, 70, 229, 0.2);">
            <div class="fm-stat-icon" style="background: rgba(255,255,255,0.2); color: white;">⏱️</div>
            <div class="fm-stat-info">
                <span class="fm-stat-number" style="color: white;">@Model.ZamanKazanciSaat sa</span>
                <span class="fm-stat-label" style="color: rgba(255,255,255,0.8);">Zaman Kazancı</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Activity Feed -->
    <div class="col-md-8">
        <div class="fm-card">
            <h5 class="fm-card-title">📡 Son Aktiviteler (Activity Feed)</h5>
            <div class="fm-feature-list mt-3">
                @if (Model.Aktiviteler != null && Model.Aktiviteler.Any())
                {
                    foreach (var aktivite in Model.Aktiviteler)
                    {
                        <div class="fm-feature-item d-flex align-center gap-2">
                            <span style="font-size: 1.5rem;">@aktivite.Ikon</span>
                            <div class="d-flex flex-column" style="flex:1;">
                                <div class="d-flex justify-between align-center">
                                    <strong class="text-@aktivite.Tur">@aktivite.Baslik</strong>
                                    <span class="text-muted" style="font-size:0.75rem;">@aktivite.Tarih.ToString("HH:mm")</span>
                                </div>
                                <span style="font-size:0.85rem; color:var(--fm-text-secondary); margin-top:2px;">@aktivite.Aciklama</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="fm-empty">
                        <div class="fm-empty-icon">📭</div>
                        <div class="fm-empty-text">Henüz bir aktivite bulunmuyor.</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sistem Durumu -->
    <div class="col-md-4">
        <div class="fm-card fm-card-status">
            <h5 class="fm-card-title">⚙️ Sistem Durumu</h5>
            <div class="fm-status-info">
                <div class="fm-status-indicator fm-status-online"></div>
                <span>@Model.SistemDurumu</span>
            </div>
            <hr class="fm-divider" />
            <div class="fm-status-details">
                <div class="fm-status-row">
                    <span>API Servisi</span>
                    <span class="fm-badge fm-badge-success">Aktif</span>
                </div>
                <div class="fm-status-row">
                    <span>Karar Motoru</span>
                    <span class="fm-badge fm-badge-success">Aktif</span>
                </div>
                <div class="fm-status-row">
                    <span>Veritabanı</span>
                    <span class="fm-badge fm-badge-success">Aktif</span>
                </div>
            </div>
            
            <div class="mt-3 text-center">
                <a href="/Workflow/Create" class="fm-btn fm-btn-primary w-100">
                    <span>➕ Yeni İş Akışı Başlat</span>
                </a>
            </div>
        </div>
    </div>
</div>
