@model FlowMind.Models.Workflow
@{
    ViewData["Title"] = "Yeni İş Akışı";
}

<div class="mb-4">
    <h2 style="font-weight: 700; margin-bottom: 0.2rem;">➕ Yeni İş Akışı Oluştur</h2>
    <p class="text-muted" style="margin:0;">Sisteme yeni bir sipariş, talep veya onay süreci başlatın.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="fm-card">
            <form asp-action="Create" method="post">

                <div class="fm-form-group">
                    <label class="fm-label" asp-for="Ad">İş Akışı / Talep Adı</label>
                    <input asp-for="Ad" class="fm-input" placeholder="Örn: Laptop Satınalma Talebi, Yıllık İzin, Fatura Onayı" required />
                </div>

                <div class="fm-form-group">
                    <label class="fm-label">Konu / Kategori</label>
                    <select name="Konu" id="konuSelect" class="fm-input" onchange="konuDegisti()">
                        <option value="Satınalma">Satınalma Talebi</option>
                        <option value="Sipariş">Sipariş Yönetimi</option>
                        <option value="Fatura">Fatura Onayı</option>
                        <option value="İade">İade / Değişim</option>
                        <option value="İzin">İzin Talebi</option>
                        <option value="Diğer">Diğer</option>
                    </select>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fm-form-group">
                            <label class="fm-label">Departman</label>
                            <select name="Departman" class="fm-input" required>
                                <option value="">Departman Seçiniz</option>
                                <option value="Bilişim">Bilişim / IT</option>
                                <option value="Finans">Finans / Muhasebe</option>
                                <option value="Satış">Satış / Pazarlama</option>
                                <option value="İnsan Kaynakları">İnsan Kaynakları</option>
                                <option value="Lojistik">Lojistik / Depo</option>
                                <option value="Hukuk">Hukuk</option>
                                <option value="Yönetici">Yönetici</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- Dinamik Alanlar -->
                    <div class="col-md-6" id="tutarAlani">
                        <div class="fm-form-group">
                            <label class="fm-label">Tutar (₺)</label>
                            <input type="number" name="Tutar" class="fm-input" placeholder="Örn: 15000" min="0" step="0.01" />
                        </div>
                    </div>

                    <div class="col-md-6" id="izinSebebiAlani" style="display:none;">
                        <div class="fm-form-group">
                            <label class="fm-label">İzin Sebebi</label>
                            <select name="IzinSebebi" class="fm-input">
                                <option value="">Seçiniz</option>
                                <option value="Hastalık Raporu">Hastalık Raporu</option>
                                <option value="Vefat">Vefat</option>
                                <option value="Düğün/Evlilik">Düğün / Evlilik</option>
                                <option value="Doğum">Doğum İzni</option>
                                <option value="Yıllık İzin">Yıllık İzin</option>
                                <option value="Mazeret İzni">Mazeret İzni</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6" id="iadeSebebiAlani" style="display:none;">
                        <div class="fm-form-group">
                            <label class="fm-label">İade Sebebi</label>
                            <select name="IadeSebebi" class="fm-input">
                                <option value="">Seçiniz</option>
                                <option value="Kusurlu Ürün">Kusurlu Ürün</option>
                                <option value="Yanlış Ürün Gönderimi">Yanlış Ürün Gönderimi</option>
                                <option value="Cayma Hakkı / Vazgeçtim">Cayma Hakkı / Vazgeçtim</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="fm-form-group">
                    <label class="fm-label" asp-for="Tetikleyici">Tetikleyici Durum</label>
                    <input asp-for="Tetikleyici" class="fm-input" placeholder="Örn: Personel talep oluşturduğunda" />
                </div>

                <div class="fm-form-group">
                    <label class="fm-label" asp-for="Aciklama">Açıklama / Gerekçe</label>
                    <textarea asp-for="Aciklama" class="fm-textarea" rows="3" placeholder="Talebin detaylı açıklaması..."></textarea>
                </div>

                <div class="fm-form-group">
                    <label class="fm-label">Durum</label>
                    <div class="d-flex align-center gap-2">
                        <input type="checkbox" asp-for="Aktif" checked />
                        <span style="font-size: 0.88rem;">Aktif olarak başla</span>
                    </div>
                </div>

                <hr class="fm-divider" />

                <div class="d-flex justify-between">
                    <a asp-action="Index" class="fm-btn fm-btn-secondary">İptal</a>
                    <button type="submit" class="fm-btn fm-btn-primary">🚀 Talebi Oluştur ve Başlat</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-4">
        <div class="fm-card" style="background: linear-gradient(135deg, rgba(79, 70, 229, 0.05), rgba(79, 70, 229, 0.1)); border: 1px solid var(--fm-primary);">
            <h5 class="fm-card-title" style="color: var(--fm-primary);">✨ Otomatik Adım Oluşturma</h5>
            <p class="fm-card-text" style="font-size: 0.85rem;">
                Talebi oluşturduğunuz anda, seçtiğiniz <strong>Konu</strong> ve <strong>Departman</strong> bilgilerine göre iş akışı adımları yapay zeka destekli sistemimiz tarafından <strong>otomatik olarak</strong> oluşturulacaktır.
            </p>
            <div class="fm-feature-list" style="margin-top: 10px;">
                <div class="fm-feature-item" style="padding: 8px 12px; font-size: 0.82rem; background: white;">
                    📦 <strong>Satınalma/Sipariş:</strong> AI Risk Analizi + ERP Entegrasyonu
                </div>
                <div class="fm-feature-item" style="padding: 8px 12px; font-size: 0.82rem; background: white;">
                    🏖️ <strong>İzin Talebi:</strong> Yönetici Onayı + İK Bildirimi
                </div>
                <div class="fm-feature-item" style="padding: 8px 12px; font-size: 0.82rem; background: white;">
                    📄 <strong>Fatura/Diğer:</strong> AI Değerlendirme + İlgili Birim Onayı
                </div>
            </div>
        </div>
        <div class="fm-card mt-3">
            <h5 class="fm-card-title">💡 İpucu</h5>
            <p class="fm-card-text" style="font-size: 0.85rem;">
                Tutar bilgisi girdiğinizde, AI Karar Motoru riski değerlendirerek ₺5.000 altına otomatik onay verebilir, üstünü ise yöneticinize atayabilir.
            </p>
        </div>
    </div>
</div>

<script>
function konuDegisti() {
    var konu = document.getElementById('konuSelect').value;
    var tutarAlani = document.getElementById('tutarAlani');
    var izinSebebiAlani = document.getElementById('izinSebebiAlani');
    var iadeSebebiAlani = document.getElementById('iadeSebebiAlani');

    // Reset visibility
    tutarAlani.style.display = 'none';
    izinSebebiAlani.style.display = 'none';
    iadeSebebiAlani.style.display = 'none';

    if (konu === 'İzin') {
        izinSebebiAlani.style.display = '';
    } else if (konu === 'İade') {
        iadeSebebiAlani.style.display = '';
    } else if (konu !== 'Diğer') {
        // Satınalma, Sipariş, Fatura
        tutarAlani.style.display = '';
    }
}
konuDegisti();
</script>
