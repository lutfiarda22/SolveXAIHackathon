@{
    ViewData["Title"] = "AI Karar Sonucu";
    var workflow = (FlowMind.Models.Workflow)ViewBag.Workflow;
    var decision = ViewBag.Decision as FlowMind.Models.AIDecision;
    var instanceId = (string)ViewBag.InstanceId;
}

<div class="mb-4 text-center">
    <h2 style="font-weight: 700;">🤖 AI Karar Sonucu</h2>
    <p class="text-muted">İş Akışı: <strong>@workflow.Ad</strong> | Instance: @instanceId</p>
</div>

@if (decision != null)
{
    var actionColor = decision.SuggestedAction switch
    {
        FlowMind.Models.AIAction.OtomatikOnayla => "#10b981",
        FlowMind.Models.AIAction.ManuelInceleme => "#f59e0b",
        FlowMind.Models.AIAction.OncelikliYonlendir => "#f59e0b",
        FlowMind.Models.AIAction.AdimAtla => "#6366f1",
        FlowMind.Models.AIAction.Reddet => "#ef4444",
        _ => "#6b7280"
    };

    var actionIcon = decision.SuggestedAction switch
    {
        FlowMind.Models.AIAction.OtomatikOnayla => "✅",
        FlowMind.Models.AIAction.ManuelInceleme => "⚠️",
        FlowMind.Models.AIAction.OncelikliYonlendir => "🔀",
        FlowMind.Models.AIAction.AdimAtla => "⏭️",
        FlowMind.Models.AIAction.Reddet => "❌",
        _ => "❓"
    };

    var actionText = decision.SuggestedAction switch
    {
        FlowMind.Models.AIAction.OtomatikOnayla => "Otomatik Onaylandı",
        FlowMind.Models.AIAction.ManuelInceleme => "Manuel İnceleme Gerekli",
        FlowMind.Models.AIAction.OncelikliYonlendir => "Öncelikli Yönlendirme",
        FlowMind.Models.AIAction.AdimAtla => "Adım Atlandı",
        FlowMind.Models.AIAction.Reddet => "Reddedildi",
        _ => "Bilinmiyor"
    };

    var scorePercent = (int)(decision.ConfidenceScore * 100);

    <div class="row g-4 justify-center">
        <div class="col-md-8">
            <!-- Karar Kartı -->
            <div class="fm-card" style="border-left: 4px solid @actionColor;">
                <div class="text-center mb-4">
                    <div style="font-size: 3rem;">@actionIcon</div>
                    <h3 style="color: @actionColor; font-weight: 700; margin: 8px 0 4px;">@actionText</h3>
                    <span class="text-muted" style="font-size: 0.85rem;">Karar @decision.KararZamani.ToString("dd.MM.yyyy HH:mm:ss") tarihinde verildi</span>
                </div>

                <hr class="fm-divider" />

                <!-- Güven Skoru -->
                <div class="mb-4">
                    <div class="d-flex justify-between align-center mb-2">
                        <strong style="font-size: 0.9rem;">Güven Skoru</strong>
                        <span style="font-size: 1.4rem; font-weight: 700; color: @actionColor;">%@scorePercent</span>
                    </div>
                    <div style="background: rgba(255,255,255,0.05); border-radius: 8px; height: 12px; overflow: hidden;">
                        <div style="background: @actionColor; width: @(scorePercent)%; height: 100%; border-radius: 8px; transition: width 0.8s ease;"></div>
                    </div>
                </div>

                <!-- Gerekçe -->
                <div class="mb-4">
                    <strong style="font-size: 0.9rem;">📝 AI Gerekçesi</strong>
                    <div class="fm-card" style="margin-top: 8px; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.15);">
                        <p style="margin: 0; font-size: 0.92rem; line-height: 1.6;">@decision.Reason</p>
                    </div>
                </div>

                <!-- Bağlam -->
                <div class="mb-4">
                    <strong style="font-size: 0.9rem;">📊 Değerlendirilen Veriler</strong>
                    <div class="fm-card" style="margin-top: 8px; background: rgba(255,255,255,0.03);">
                        <p style="margin: 0; font-size: 0.82rem; color: var(--fm-text-secondary);">@decision.Baglan</p>
                    </div>
                </div>

                <!-- Teknik Detaylar -->
                <div class="d-flex justify-between text-muted" style="font-size: 0.75rem;">
                    <span>Karar ID: @decision.Id</span>
                    <span>İşlem Süresi: @decision.IslemSuresiMs ms</span>
                </div>
            </div>

            <!-- Aksiyon Butonları -->
            <div class="d-flex gap-3 mt-3">
                <a asp-action="Details" asp-route-id="@workflow.Id" class="fm-btn fm-btn-secondary" style="flex:1; text-align:center;">
                    📋 İş Akışı Detayına Dön
                </a>
                <a asp-controller="Task" asp-action="Index" class="fm-btn fm-btn-primary" style="flex:1; text-align:center;">
                    📋 Görevlere Git
                </a>
                <a asp-controller="Audit" asp-action="Index" class="fm-btn fm-btn-secondary" style="flex:1; text-align:center;">
                    📜 Denetim Günlüğü
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="row justify-center">
        <div class="col-md-6">
            <div class="fm-card text-center p-5">
                <div style="font-size: 3rem;">ℹ️</div>
                <h4>Karar Bilgisi Bulunamadı</h4>
                <p class="text-muted">Bu iş akışında henüz tanımlı adım olmadığı için AI karar motoru devreye girmedi.</p>
                <a asp-action="Details" asp-route-id="@workflow.Id" class="fm-btn fm-btn-primary mt-3">
                    Detaya Dön ve Adım Ekle
                </a>
            </div>
        </div>
    </div>
}
