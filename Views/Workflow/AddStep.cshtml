@model FlowMind.Models.WorkflowStep
@{
    ViewData["Title"] = "Yeni Adım Ekle";
    var konu = (string)ViewBag.Konu;
}

<div class="d-flex justify-between align-center mb-4">
    <div>
        <h2 style="font-weight: 700; margin-bottom: 0.2rem;">Yeni Adım Ekle</h2>
        <p class="text-muted" style="margin:0;">İş Akışı: @ViewBag.WorkflowName (@ViewBag.WorkflowId) — Konu: @konu</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@ViewBag.WorkflowId" class="fm-btn fm-btn-secondary">İptal</a>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <!-- Hazır Şablonlar -->
        <div class="fm-card mb-3">
            <h5 class="fm-card-title">⚡ Hızlı Adım Ekle</h5>
            <p class="text-muted" style="font-size:0.82rem; margin-bottom: 12px;">Konunuza uygun hazır adım şablonlarından birini seçin:</p>

            <div class="fm-feature-list">
                @if (konu == "İzin")
                {
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Yönetici Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <input type="hidden" name="Kosul" value="İzin süresi kontrol edilecek" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            ✅ <strong>Yönetici Onayı</strong> — Birim yöneticisinin izin talebini onaylaması
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="İK Departmanı Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="İnsan Kaynakları" />
                        <input type="hidden" name="Kosul" value="Kalan izin günü kontrol edilecek" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            👥 <strong>İK Departmanı Onayı</strong> — İnsan kaynakları izin bakiyesini kontrol eder
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="E-Posta Bildirimi" />
                        <input type="hidden" name="EylemTuru" value="Bildirim" />
                        <input type="hidden" name="AtananKisi" value="İnsan Kaynakları" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📧 <strong>E-Posta Bildirimi</strong> — Sonuç personele ve yöneticiye bildirilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Takvim Güncelleme" />
                        <input type="hidden" name="EylemTuru" value="Entegrasyon" />
                        <input type="hidden" name="AtananKisi" value="Bilişim" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📅 <strong>Takvim Güncelleme</strong> — Şirket takviminde izin kaydı oluşturulur
                        </button>
                    </form>
                }
                else if (konu == "Satınalma")
                {
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Yönetici Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <input type="hidden" name="Kosul" value="Tutar kontrol edilecek" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            ✅ <strong>Yönetici Onayı</strong> — Birim yöneticisinin satınalmayı onaylaması
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Finans Kontrolü" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Finans" />
                        <input type="hidden" name="Kosul" value="Bütçe kontrolü yapılacak" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            💰 <strong>Finans Kontrolü</strong> — Bütçe ve ödeme planı kontrol edilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="ERP Sipariş Kaydı" />
                        <input type="hidden" name="EylemTuru" value="Entegrasyon" />
                        <input type="hidden" name="AtananKisi" value="Bilişim" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            🔌 <strong>ERP Sipariş Kaydı</strong> — ERP sistemine otomatik satınalma emri
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="CRM Kayıt" />
                        <input type="hidden" name="EylemTuru" value="Entegrasyon" />
                        <input type="hidden" name="AtananKisi" value="Satış" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📋 <strong>CRM Kayıt</strong> — Müşteri ilişkileri sistemine kayıt oluşturulur
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Bildirim Gönder" />
                        <input type="hidden" name="EylemTuru" value="Bildirim" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📧 <strong>Bildirim Gönder</strong> — İlgili kişilere sonuç bildirilir
                        </button>
                    </form>
                }
                else if (konu == "Sipariş")
                {
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Stok Kontrolü" />
                        <input type="hidden" name="EylemTuru" value="YZKarar" />
                        <input type="hidden" name="AtananKisi" value="Lojistik" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📦 <strong>Stok Kontrolü</strong> — Depoda yeterli stok olup olmadığı kontrol edilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Sipariş Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Satış" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            ✅ <strong>Sipariş Onayı</strong> — Satış ekibi siparişi doğrular
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Fatura Oluşturma" />
                        <input type="hidden" name="EylemTuru" value="Entegrasyon" />
                        <input type="hidden" name="AtananKisi" value="Finans" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            🧾 <strong>Fatura Oluşturma</strong> — ERP'de otomatik fatura kesilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Kargo Bildirimi" />
                        <input type="hidden" name="EylemTuru" value="Bildirim" />
                        <input type="hidden" name="AtananKisi" value="Lojistik" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            🚚 <strong>Kargo Bildirimi</strong> — Müşteriye kargo takip bilgisi gönderilir
                        </button>
                    </form>
                }
                else if (konu == "Fatura")
                {
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Finans İncelemesi" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Finans" />
                        <input type="hidden" name="Kosul" value="Fatura tutarı kontrol edilecek" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            💰 <strong>Finans İncelemesi</strong> — Muhasebe fatura detaylarını kontrol eder
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Yönetici Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            ✅ <strong>Yönetici Onayı</strong> — Üst yönetim nihai onayı verir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="ERP Ödeme Kaydı" />
                        <input type="hidden" name="EylemTuru" value="Entegrasyon" />
                        <input type="hidden" name="AtananKisi" value="Finans" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            🔌 <strong>ERP Ödeme Kaydı</strong> — Ödeme emri otomatik oluşturulur
                        </button>
                    </form>
                }
                else if (konu == "İade")
                {
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Müşteri Hizmetleri İncelemesi" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Satış" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            🔍 <strong>Müşteri Hizmetleri İncelemesi</strong> — İade sebebi değerlendirilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Yönetici Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            ✅ <strong>Yönetici Onayı</strong> — İade onayı verilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="ERP İade Kaydı" />
                        <input type="hidden" name="EylemTuru" value="Entegrasyon" />
                        <input type="hidden" name="AtananKisi" value="Finans" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            💳 <strong>ERP İade/İade Faturası</strong> — İade ve ödeme iptali kaydedilir
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Müşteriye Bildirim" />
                        <input type="hidden" name="EylemTuru" value="Bildirim" />
                        <input type="hidden" name="AtananKisi" value="Satış" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📧 <strong>Müşteriye Bildirim</strong> — İade sonucu müşteriye bildirilir
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Yönetici Onayı" />
                        <input type="hidden" name="EylemTuru" value="Onay" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            ✅ <strong>Yönetici Onayı</strong> — Genel yönetici onayı
                        </button>
                    </form>
                    <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post" style="display:inline;">
                        <input type="hidden" name="Ad" value="Bildirim Gönder" />
                        <input type="hidden" name="EylemTuru" value="Bildirim" />
                        <input type="hidden" name="AtananKisi" value="Yonetici" />
                        <input type="hidden" name="YZAtlayabilir" value="true" />
                        <button type="submit" class="fm-feature-item" style="width:100%; text-align:left; background:none; border:none; cursor:pointer; color:inherit; padding: 10px 14px;">
                            📧 <strong>Bildirim Gönder</strong> — İlgili kişilere bildirim
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Manuel Ekleme -->
        <div class="fm-card">
            <h5 class="fm-card-title">✏️ Manuel Adım Ekle</h5>
            <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post">
                <div class="fm-form-group">
                    <label class="fm-label">Adım Adı</label>
                    <input name="Ad" class="fm-input" placeholder="Örn: Özel kontrol adımı" required />
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fm-form-group">
                            <label class="fm-label">Eylem Türü</label>
                            <select name="EylemTuru" class="fm-input">
                                <option value="Onay">✅ Onay</option>
                                <option value="Entegrasyon">🔌 Entegrasyon</option>
                                <option value="Bildirim">📢 Bildirim</option>
                                <option value="YZKarar">🤖 YZ Karar</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fm-form-group">
                            <label class="fm-label">Atanan Departman</label>
                            <select name="AtananKisi" class="fm-input">
                                <option value="Yonetici">Yönetici</option>
                                <option value="Finans">Finans</option>
                                <option value="Bilişim">Bilişim</option>
                                <option value="Satış">Satış</option>
                                <option value="İnsan Kaynakları">İnsan Kaynakları</option>
                                <option value="Lojistik">Lojistik</option>
                                <option value="Hukuk">Hukuk</option>
                            </select>
                        </div>
                    </div>
                </div>
                <button type="submit" class="fm-btn fm-btn-primary">➕ Ekle</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="fm-card">
            <h5 class="fm-card-title">💡 @konu Süreci Hakkında</h5>
            @if (konu == "İzin")
            {
                <p class="fm-card-text" style="font-size: 0.85rem;">
                    İzin talebi süreci genelde şu adımlardan oluşur:<br/>
                    <strong>1.</strong> Yönetici Onayı → <strong>2.</strong> İK Onayı → <strong>3.</strong> Bildirim → <strong>4.</strong> Takvim Güncelleme
                </p>
            }
            else if (konu == "Satınalma")
            {
                <p class="fm-card-text" style="font-size: 0.85rem;">
                    Satınalma süreci genelde şu adımlardan oluşur:<br/>
                    <strong>1.</strong> Yönetici Onayı → <strong>2.</strong> Finans Kontrolü → <strong>3.</strong> ERP Kaydı → <strong>4.</strong> CRM Kaydı → <strong>5.</strong> Bildirim
                </p>
            }
            else if (konu == "Sipariş")
            {
                <p class="fm-card-text" style="font-size: 0.85rem;">
                    Sipariş yönetimi genelde şu adımlardan oluşur:<br/>
                    <strong>1.</strong> Stok Kontrolü → <strong>2.</strong> Sipariş Onayı → <strong>3.</strong> Fatura → <strong>4.</strong> Kargo Bildirimi
                </p>
            }
            else if (konu == "Fatura")
            {
                <p class="fm-card-text" style="font-size: 0.85rem;">
                    Fatura onay süreci genelde şu adımlardan oluşur:<br/>
                    <strong>1.</strong> Finans İncelemesi → <strong>2.</strong> Yönetici Onayı → <strong>3.</strong> ERP Ödeme Kaydı
                </p>
            }
            else if (konu == "İade")
            {
                <p class="fm-card-text" style="font-size: 0.85rem;">
                    İade süreci genelde şu adımlardan oluşur:<br/>
                    <strong>1.</strong> Müş. Hiz. İnceleme → <strong>2.</strong> Yönetici Onayı → <strong>3.</strong> ERP İade → <strong>4.</strong> Müşteri Bildirimi
                </p>
            }
            else
            {
                <p class="fm-card-text" style="font-size: 0.85rem;">
                    İhtiyacınıza göre hazır şablonlardan veya manuel olarak adım ekleyebilirsiniz.
                </p>
            }
        </div>
    </div>
</div>
