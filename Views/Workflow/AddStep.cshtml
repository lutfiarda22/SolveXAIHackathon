@model FlowMind.Models.WorkflowStep
@{
    ViewData["Title"] = "Yeni Adım Ekle";
}

<div class="d-flex justify-between align-center mb-4">
    <div>
        <h2 style="font-weight: 700; margin-bottom: 0.2rem;">Yeni Adım Ekle</h2>
        <p class="text-muted" style="margin:0;">İş Akışı: @ViewBag.WorkflowName (@ViewBag.WorkflowId)</p>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@ViewBag.WorkflowId" class="fm-btn fm-btn-secondary">İptal</a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="fm-card">
            <form asp-action="AddStep" asp-route-id="@ViewBag.WorkflowId" method="post">
                <div class="mb-3">
                    <label asp-for="Ad" class="form-label">Adım Adı</label>
                    <input asp-for="Ad" class="form-control" placeholder="Örn: Hukuk İncelemesi" required />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EylemTuru" class="form-label">Eylem Türü</label>
                    <select asp-for="EylemTuru" class="form-select" asp-items="Html.GetEnumSelectList<FlowMind.Models.StepActionType>()">
                    </select>
                    <span asp-validation-for="EylemTuru" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AtananKisi" class="form-label">Atanan Kişi / Rol</label>
                    <input asp-for="AtananKisi" class="form-control" placeholder="Örn: Hukuk Departmanı" />
                </div>

                <div class="mb-3">
                    <label asp-for="Kosul" class="form-label">Koşul (Opsiyonel)</label>
                    <input asp-for="Kosul" class="form-control" placeholder="Örn: Tutar > 10000" />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="YZAtlayabilir" class="form-check-input" type="checkbox" />
                    <label asp-for="YZAtlayabilir" class="form-check-label">
                        Yapay Zeka bu adımı atlayabilir (Güvenliyse)
                    </label>
                </div>

                <button type="submit" class="fm-btn fm-btn-primary">Adımı Ekle</button>
            </form>
        </div>
    </div>
</div>
